# ──────────────────────────────────────────────────────────────────────────────
# Geocodes simplified stack — environment configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Project name (DNS-safe, lowercase, no underscores). Used as a label and as
# part of the Qlever container name (qlever-<PROJECT>).
PROJECT=geocodes

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# IAM credentials that have s3:GetObject / s3:PutObject on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The bucket where Gleaner/Nabu write crawled data.
S3_BUCKET=my-geocodes-bucket

# Override only if not using standard AWS S3 (e.g. MinIO dev, Wasabi, etc.)
# GLEANERIO_MINIO_ADDRESS=s3.amazonaws.com
# GLEANERIO_MINIO_PORT=443
# GLEANERIO_MINIO_USE_SSL=true

# ── Qlever UI ─────────────────────────────────────────────────────────────────
# Generate a random secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
QLEVERUI_SECRET_KEY=

# Comma-separated origins trusted for CSRF (include your public hostname).
QLEVERUI_CSRF_TRUSTED_ORIGINS=http://localhost

# ── FacetSearch ───────────────────────────────────────────────────────────────
SITE_TITLE=Geocodes
BUCKETPATH=summoned
URIVERSION=v2
TOOLPATH=summoned
TOOLREPO=ecrr_submitted

# ── Docker image tags ─────────────────────────────────────────────────────────
# Leave as "latest" for the most recent release.
FACETS_TAG=latest
DAGSTER_TAG=latest

# ── Dagster ───────────────────────────────────────────────────────────────────
GLEANERIO_GLEANER_IMAGE=nsfearthcube/gleaner:latest
GLEANERIO_NABU_IMAGE=nsfearthcube/nabu:latest

# Cron-style schedule for automated crawl runs.
# Valid values: @hourly, @daily, @weekly, @monthly, or a cron expression.
GLEANERIO_DEFAULT_SCHEDULE=@weekly
GLEANERIO_DEFAULT_SCHEDULE_TIMEZONE=America/Los_Angeles

# S3 path prefix where Gleaner/Nabu configs and logs are stored.
GLEANERIO_CONFIG_PATH=scheduler/configs/

# Seconds to wait after restarting Qlever before declaring it healthy.
# A large corpus may need 600-1200 s for indexing to complete.
QLEVER_HEALTH_TIMEOUT=600

# Seconds to wait for a Gleaner/Nabu container to finish before timing out.
GLEANERIO_DOCKER_CONTAINER_WAIT_TIMEOUT=300

# ── Headless browser (optional) ───────────────────────────────────────────────
# Only needed if any of your data sources require JavaScript rendering.
# Start chromedp/headless-shell separately and point to it here.
# GLEANERIO_HEADLESS_NETWORK=headless_gleanerio
# GLEANERIO_HEADLESS_ENDPOINT=http://headless:9222

# ── Networking ────────────────────────────────────────────────────────────────
HTTP_PORT=80
DAGSTER_PORT=3001
